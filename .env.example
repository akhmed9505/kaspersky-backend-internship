# Examples only; the Go process does not automatically read this file.
# Copy to a local .env and fill the three empty secret values; never commit .env.
HTTPS_ADDR=:8443
TLS_CERT_FILE=${HOME}/.local/share/kaspersky-backend-internship/server.crt
TLS_KEY_FILE=${HOME}/.local/share/kaspersky-backend-internship/server.key
API_KEY=
# Native Go run settings. Compose always uses its own db:5432 internally.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kaspersky
DB_NAME=kaspersky
DB_PASSWORD=
# Separate administrator password, used only by Compose, not by the application.
POSTGRES_PASSWORD=
# Local database only; the default is verify-full for remote connections.
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=16384
GLOBAL_RPS=100
GLOBAL_BURST=200
AUTHORIZED_RPS=10
AUTHORIZED_BURST=20
LOG_LEVEL=INFO
